{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Central de Ajuda Leavo AI",
  "colors": {
    "primary": "#F04438",
    "light": "#F97066",
    "dark": "#D92D20"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/logo-light.svg",
    "dark": "/logo/logo-dark.svg"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "API Status",
          "href": "https://status.leavo.ai",
          "icon": "signal"
        },
        {
          "anchor": "Suporte",
          "href": "mailto:suporte@leavo.ai",
          "icon": "envelope"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Central de Ajuda",
        "groups": [
          {
            "group": "Início",
            "pages": ["introduction"]
          },
          {
            "group": "Plataforma",
            "pages": [
              "quickstart",
              "account-setup",
              "concepts/overview",
              "concepts/workspace",
              "concepts/members-roles"
            ]
          },
          {
            "group": "Comercial",
            "pages": [
              "guides/dashboard",
              "guides/managing-data",
              "guides/notifications",
              "integrations/overview",
              "guides/billing"
            ]
          },
          {
            "group": "Conta",
            "pages": [
              "integrations/webhooks",
              "integrations/sso"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Suporte",
        "href": "mailto:suporte@leavo.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.leavo.ai"
    }
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/leavoai"
    }
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true
  },
  "search": {
    "prompt": "Buscar na central de ajuda..."
  }
}
